APP_ENV=development
DEBUG=true

# Postgres from the root docker-compose.yml (service "db"), shared with auth
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/talent_iq

# Must be identical to the auth service's JWT_SECRET_KEY
JWT_SECRET_KEY=change-me
JWT_ISSUER=talentiq-auth
JWT_AUDIENCE=talentiq-core

# LLM via OpenRouter (free models); fallbacks are tried in order
OPENROUTER_API_KEY=
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_PROVIDER_ORDER=[]
LLM_FALLBACK_MODELS=["nvidia/nemotron-3.5-super-vl:free","google/gemma-4-31b-it:free"]

# Embeddings (768 dims to match the DB columns); key defaults to LLM_API_KEY
EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
EMBEDDING_DIMENSIONS=768

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
