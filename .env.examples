APP_ENV=development
DEBUG=true

# Postgres from the root docker-compose.yml (service "db"), shared with auth
DATABASE_URL=postgresql+asyncpg://postgres:change-me@db:5432/talent_iq

# Must be identical to the auth service's JWT_SECRET_KEY
JWT_SECRET_KEY=change-me
JWT_ISSUER=talentiq-auth
JWT_AUDIENCE=talentiq-core

# Free-tier LLM providers; tried in this order: Gemini -> Groq -> OpenRouter
GOOGLE_GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Embeddings: Gemini, 768 dims (must match the DB vector columns)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage

# Optional sourcing keys (leave empty to skip a source)
GITHUB_TOKEN=
STACKEXCHANGE_KEY=
